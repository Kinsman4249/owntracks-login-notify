# Example /etc/default/owntracks-login-notify
#
# install.sh creates this file for you and populates it from your answers.
# This example exists purely as documentation — you do NOT need to copy it
# anywhere manually. Run `sudo bash install.sh` and you'll be prompted for
# each value.
#
# The real file lives at /etc/default/owntracks-login-notify and is
# chmod 600, root-owned, because it contains the smtp2go API key.

# --- Required ---

# smtp2go API key
SMTP2GO_KEY="api-xxxxxxxxxxxxxxxxxxxx"

# Verified sender address in smtp2go
FROM_EMAIL="you@example.com"

# Notification recipient
TO_EMAIL="you@example.com"

# --- Optional (defaults shown) ---

# nginx access log to tail
NGINX_LOG="/var/log/nginx/access.log"

# URL path prefix to watch (trailing slash required)
WATCH_PATH="/owntracks/"

# Seconds before an IP is considered new again (default 30 days)
IP_TTL=2592000

# Directory for per-IP timestamp files
SEEN_IPS_DIR="/var/lib/owntracks/seen_ips"

# Cached Cloudflare CIDR list (auto-refreshed on each service start)
CF_RANGES_FILE="/var/lib/owntracks/cf_ranges.txt"

# --- Cloudflare ASN failsafe (optional; defaults shown) ---
#
# The published ips-v4/ips-v6 lists are only Cloudflare's customer-facing
# ranges. AS13335 announces more (WARP, Zero Trust, Spectrum, newer
# allocations), which is why some Cloudflare IPs can slip past a CIDR-only
# filter. These two layers close that gap; both use curl over HTTPS.

# Cloudflare's autonomous system number.
CF_ASN=13335

# Layer 1: at startup, also merge every prefix announced by AS<CF_ASN>
# (from RIPEstat) into the grepcidr ranges file. Set to 0 to disable.
ASN_PREFIX_EXPANSION=1

# Layer 2: just before sending, look up the candidate IP's ASN and skip it
# if it is Cloudflare's. Only runs for would-be alerts. Fails open (an
# unreachable lookup service never suppresses a real alert). Set to 0 to disable.
ASN_FAILSAFE=1

# Per-IP ASN lookup timeout, in seconds.
ASN_LOOKUP_TIMEOUT=3

# ASN lookup endpoint. The candidate IP is appended to this URL.
# Default is RIPEstat's network-info API (same provider as Layer 1 — no WAF
# in front of it). Responses in either RIPEstat shape ({"data":{"asns":[..]}})
# or iptoasn shape ({"as_number":N}) are understood, so iptoasn-compatible
# services also work here if you prefer one.
ASN_LOOKUP_URL="https://stat.ripe.net/data/network-info/data.json?resource="

# RIPEstat announced-prefixes base. "AS<CF_ASN>" is appended to this URL.
RIPESTAT_URL="https://stat.ripe.net/data/announced-prefixes/data.json?resource="
