[Unit]
Description=OwnTracks login notifier
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
# Config (SMTP2GO_KEY, FROM_EMAIL, TO_EMAIL, NGINX_LOG, WATCH_PATH, IP_TTL,
# SEEN_IPS_DIR, CF_RANGES_FILE) is loaded from this file. install.sh creates
# and populates it. Do NOT edit the script itself to set credentials.
EnvironmentFile=/etc/default/owntracks-login-notify
ExecStart=/usr/local/bin/owntracks-login-notify.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
